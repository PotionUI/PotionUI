  "3": {
    "inputs": {
      "seed": 1,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["22", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    },
    "class_type": "KSampler",
    "_meta": {"title": "KSampler"}
  },
  "8": {
    "inputs": {"samples": ["3", 0], "vae": ["12", 0]},
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"}
  },
  "9": {
    "inputs": {"images": ["8", 0], "filename_prefix": "ComfyUI"},
    "class_type": "SaveImage",
