    },
    "class_type": "LoraLoader",
    "_meta": {"title": "LoRA 1 (model + clip)"}
  },
  "102": {
    "inputs": {"lora_name": "style_b.safetensors", "strength_model": 0.6, "model": ["101", 0]},
