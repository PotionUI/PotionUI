{
  "version": 1,
  "description": "Panel detection goldens shared by pytest and vitest. Each case is rasterised, never loaded from a file.",
  "raster": {
    "transparent": "when true the image is RGBA: background pixels are (0,0,0,0) and box pixels are opaque; no noise is used",
    "order": "fill background, draw boxes in order with their colour, then add noise to every channel of every pixel and clamp to 0..255",
    "noise": "for pixel p (row-major) and channel c: idx = p*3+c; h = ((idx*2654435761) + seed*97) mod 2^32; h = ((h xor (h >> 15)) * 2246822519) mod 2^32; h = h xor (h >> 13); offset = (h mod (2*amplitude+1)) - amplitude",
    "box": "x0,y0 inclusive, x1,y1 exclusive, in pixels"
  },
  "match": "panels are compared in order; x, y, w, h are fractions of the image and must each be within epsilon",
