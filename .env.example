# PotionUI environment configuration (example)
#
# Copying this file to `.env` is OPTIONAL: every value below has a sane default
# and PotionUI runs on localhost with no `.env` at all. Copy it only when you
# want to override a default (a production deploy, a LAN host, a custom storage
# path, or a fixed auth secret):
#
#     cp .env.example .env
#
# `api.py` loads `.env` automatically at startup (via python-dotenv), so any
# variable you uncomment here is picked up on the next start. Never commit your
# real `.env` — it may hold your auth secret. This example file holds NO real
# values or secrets; the ones shown are placeholders or defaults.


# ─── Server ──────────────────────────────────────────────────────────────────

# Bind address for `python api.py`. Default: 127.0.0.1 (localhost only). Set to
# 0.0.0.0 to accept connections from your local network - only do this on a
# trusted network, since the API has no additional network-layer protection.
# Not read by run.sh, which binds its own uvicorn process directly (127.0.0.1,
# or 0.0.0.0 with `--lan`).
#POTIONUI_HOST=127.0.0.1

# Comma-separated list of origins allowed to call the API (CORS). Leave unset to
# allow the local dev frontend (localhost/127.0.0.1 on ports 3001 and 3005).
# `run.sh` sets this for you: localhost-only by default, or "*" with `--lan`.
# Set an explicit list in production; "*" allows any origin (LAN/dev only).
#ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Verbose request/response debug logging. "true"/"1"/"yes" turns it on.
# Default: false. Keep off in production.
#DEBUG=false

# Ports used by run.sh for the backend and frontend dev server. These are read
# by run.sh only (not the app); `python api.py` always listens on 8005.
#BACKEND_PORT=8005
#FRONTEND_PORT=3001


# ─── Security / authentication ───────────────────────────────────────────────

# JWT signing secret. Set this to a long random string in any real deployment.
# If left unset, PotionUI generates one on first boot and persists it under the
# storage directory (storage/auth_secret.key, mode 0600) so sessions survive
# restarts. Setting it here overrides that file. Generate one with, e.g.:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#POTIONUI_AUTH_SECRET_KEY=

# JWT signing algorithm. Default: HS256.
#POTIONUI_AUTH_ALGORITHM=HS256

# Access-token lifetime in minutes. Default: 1440 (24 hours).
#POTIONUI_AUTH_TOKEN_EXPIRE_MINUTES=1440

# "Remember me" token lifetime in days. Default: 30.
#POTIONUI_AUTH_REMEMBER_ME_EXPIRE_DAYS=30

# Login rate limiting: max failed attempts per window, and the window length in
# seconds, before logins are throttled. Defaults: 5 attempts / 60 seconds.
#POTIONUI_AUTH_LOGIN_ATTEMPTS=5
#POTIONUI_AUTH_LOGIN_WINDOW_SECONDS=60


# ─── Credential encryption ───────────────────────────────────────────────────

# Plugin/provider credentials, backend credentials and LLM API keys are
# encrypted in the database. If none of these is set, a key is generated on
# first boot and written to `secret.key` beside the database (mode 0600).
#
# BACK THAT FILE UP. Without the key, stored credentials cannot be decrypted -
# they would have to be re-entered. Generate a key with:
#     python scripts/rotate_secret_key.py --generate
#POTIONUI_SECRET_KEY=

# Keys retained for decryption only, comma-separated. Used during a rotation so
# values written under the previous key stay readable.
#POTIONUI_SECRET_KEYS_RETIRED=

# Where the key file lives, if not beside the database.
#POTIONUI_SECRET_KEY_FILE=


# ─── Storage ─────────────────────────────────────────────────────────────────

# Base directory for generated images/videos, the auth secret file, and other
# runtime files. Default: storage (relative to the working directory). Also
# overwrites the admin-editable `file_storage_directory` setting at startup
# (see src/bootstrap/app.py's apply_startup_env_overrides) so a fresh instance
# actually saves generation output where this points, not just the auth
# secret file - existing deployments that never set this are unaffected.
#POTIONUI_STORAGE_PATH=storage

# SQLite database file path. Default: storage/db.sqlite.
#POTIONUI_DB_PATH=storage/db.sqlite

# Models directory. Overwrites the admin-editable `models_dir` setting at
# startup (same mechanism as POTIONUI_STORAGE_PATH above), so every model
# lookup/scan/download-destination in the process is consistently pointed at
# this path from boot rather than the "models" default. Used by the ephemeral
# onboarding harness (tests/e2e/harness/onboarding_e2e.py) to point at a
# read-only model depot without touching a real deployment's settings.
#POTIONUI_MODELS_DIR=models

# Setup-recipe directory (src/features/setup/recipe_catalog.py). Default:
# "content/recipes" (relative to the working directory; scans its
# marketplace/ and local/ subdirs). Lets a disposable instance load recipes
# from somewhere other than the repo's real content/recipes/ - used by
# tests/e2e/harness/onboarding_e2e.py's --fresh-download flag to exercise the
# consent+fetch path against a tiny dummy artifact instead of a real download.
#POTIONUI_RECIPES_DIR=content/recipes


# ─── Advanced ────────────────────────────────────────────────────────────────

# Write a performance profile report for each generation. Any non-empty value
# enables it (run.sh sets it to 1). Leave unset to disable.
#POTIONUI_PROFILE=1

# Minimum free VRAM (in GB) the native engine must keep before running
# inference. Leave unset to use the auto-detected default; set a floor only if
# you are tuning memory behaviour on a shared GPU.
#NATIVE_MIN_INFERENCE_MEMORY_GB=
