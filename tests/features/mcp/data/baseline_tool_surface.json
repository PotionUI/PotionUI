  "add_prompt": {
   "group": "Saved prompts",
   "parameters": {
    "properties": {
     "name": {
      "description": "Optional library name.",
      "type": "string"
     },
     "segments": {
      "items": {
       "properties": {
        "chips": {
         "description": "Complete phrasebook chip state keyed by chip id.",
         "type": "object"
        },
        "color": {
         "type": "string"
        },
        "content": {
         "default": "",
         "type": "string"
        },
        "description": {
         "type": "string"
        },
        "enabled": {
         "default": true,
         "type": "boolean"
        },
        "name": {
         "type": "string"
        },
        "type": {
         "default": "content",
         "enum": [
          "content"
         ],
         "type": "string"
        }
       },
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "usage_hint": {
      "enum": [
       "positive",
       "negative"
      ],
      "type": "string"
     },
     "variables": {
      "additionalProperties": {
       "properties": {
        "max": {
         "type": "number"
        },
        "min": {
         "type": "number"
        },
        "mode": {
         "description": "choice or number",
         "enum": [
          "shuffle",
          "pin",
          "per-image"
         ],
         "type": "string"
        },
        "options": {
         "description": "choice only",
         "items": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "properties": {
             "text": {
              "type": "string"
             },
             "when": {
              "properties": {
               "values": {
                "items": {
                 "type": "string"
                },
                "type": "array"
               },
               "var": {
                "type": "string"
               }
              },
              "required": [
               "var",
               "values"
              ],
              "type": "object"
             }
            },
            "required": [
             "text"
            ],
            "type": "object"
           }
          ]
         },
         "type": "array"
        },
        "pinnedIndex": {
         "description": "choice + pin only",
         "type": "integer"
        },
        "step": {
         "type": "number"
        },
        "type": {
         "enum": [
          "text",
          "choice",
          "number"
         ],
         "type": "string"
        },
        "value": {
         "oneOf": [
          {
           "type": "string"
          },
          {
           "type": "number"
          }
         ]
        }
       },
       "required": [
        "type"
       ],
       "type": "object"
      },
      "description": "Prompt ${name} variables, keyed by name.",
      "type": "object"
     }
    },
    "required": [
     "segments"
    ],
    "type": "object"
   },
   "spends": false,
   "unavailable": null,
   "writes": true
  },
