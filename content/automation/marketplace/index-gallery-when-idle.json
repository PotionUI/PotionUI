{
  "schema": "potionui.automation",
  "schema_version": 1,
  "kind": "automation",
  "exported_at": "2026-07-18T00:00:00+00:00",
  "automation": {
    "name": "Index gallery when idle",
    "description": "When the GPU is mostly free and no generation is running, catches up the gallery index (tags and smart search) in the background.",
    "graph": {
      "nodes": [
        {
          "id": "wait_for_idle_gpu",
          "type": "trigger.gpu_threshold",
          "position": { "x": 0, "y": 0 },
          "config": {
            "threshold_pct": 60,
            "direction": "above",
            "margin_pct": 5,
            "poll_interval_s": 10,
            "hold_s": 120,
            "require_generation_idle": true
          }
        },
        {
          "id": "drain_queue",
          "type": "action.index_media_queue",
          "position": { "x": 320, "y": 0 },
          "config": {
            "pass_types": ["tags", "clip_embed", "prompt_embed"],
            "batch_size": 8,
            "max_items": 32,
            "max_runtime_s": 60
          }
        },
        {
          "id": "notify_indexed",
          "type": "action.send_notification",
          "position": { "x": 640, "y": 0 },
          "config": {
            "title": "Gallery indexed",
            "message": "Indexed {{ upstream.drain_queue.processed_count }} items while the GPU was idle",
            "level": "success"
          }
        }
      ],
      "edges": [
        {
          "id": "idle_to_drain",
          "source": "wait_for_idle_gpu",
          "source_handle": "out",
          "target": "drain_queue",
          "target_handle": "in"
        },
        {
          "id": "drain_to_notify",
          "source": "drain_queue",
          "source_handle": "out",
          "target": "notify_indexed",
          "target_handle": "in"
        }
      ]
    }
  },
  "node_types": [
    "trigger.gpu_threshold",
    "action.index_media_queue",
    "action.send_notification"
  ]
}
