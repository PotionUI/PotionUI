  "write_condition": {
   "group": "Form & segments",
   "parameters": {
    "properties": {
     "branches": {
      "description": "Build: branches in order; the first true one wins.",
      "items": {
       "properties": {
        "join": {
         "enum": [
          "and",
          "or"
         ],
         "type": "string"
        },
        "tests": {
         "items": {
          "properties": {
           "op": {
            "enum": [
             "=",
             "!=",
             "<",
             "<=",
             ">",
             ">=",
             "in",
             "not in",
             "contains",
             "not contains",
             "is empty",
             "is not empty"
            ],
            "type": "string"
           },
           "value": {
            "description": "A number, or option text exactly as written",
            "oneOf": [
             {
              "type": "string"
             },
             {
              "type": "number"
             }
            ]
           },
           "values": {
            "description": "in / not in: options, or [from, to] for a number",
            "items": {
             "oneOf": [
              {
               "type": "string"
              },
              {
               "type": "number"
              }
             ]
            },
            "type": "array"
           },
           "var": {
            "description": "Variable name without $",
            "type": "string"
           }
          },
          "required": [
           "var",
           "op"
          ],
          "type": "object"
         },
         "type": "array"
