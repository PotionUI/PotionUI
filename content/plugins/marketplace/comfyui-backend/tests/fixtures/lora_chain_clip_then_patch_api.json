  },
  "150": {
    "inputs": {"model": ["102", 0]},
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {"title": "ModelSamplingAuraFlow (after the chain)"}
  },
  "6": {
    "inputs": {"text": "anime style", "clip": ["101", 1]},
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "CLIP Text Encode (Positive)"}
