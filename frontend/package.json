    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.18",
